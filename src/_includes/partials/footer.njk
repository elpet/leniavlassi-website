<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-grid">
      <div>
        <p class="footer-logo">Λένια Βλάσση</p>
        <p>{{ settings.legal.title }} · Γνωσιακή Συμπεριφορική Θεραπεύτρια<br>Άλιμος{% if settings.practice.onlineSessions %} &amp; online{% endif %}</p>
      </div>
      <nav class="footer-nav" aria-label="Μενού υποσέλιδου">
        <a href="/about/">Σχετικά</a>
        <a href="/services/">Υπηρεσίες</a>
        <a href="/plirofories/">Πρακτικές πληροφορίες</a>
        <a href="/blog/">Blog</a>
        <a href="/faq/">Συχνές Ερωτήσεις</a>
        <a href="/rantevou/">Κλείστε ραντεβού</a>
        <a href="/contact/">Επικοινωνία</a>
      </nav>
      <div>
        <p><a href="{{ settings.phone | telHref }}">{{ settings.phone }}</a><br><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></p>
        <p>{{ settings.address }}</p>
        {%- if settings.facebookUrl or settings.instagramUrl %}
        <p class="footer-social">
          {% if settings.facebookUrl %}<a href="{{ settings.facebookUrl }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
          {% if settings.instagramUrl %}<a href="{{ settings.instagramUrl }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
        </p>
        {%- endif %}
      </div>
    </div>

    <p class="footer-help">
      <strong>Χρειάζεστε άμεση βοήθεια;</strong>
      Έκτακτη ανάγκη <a href="tel:112">112</a> · ΕΚΑΒ <a href="tel:166">166</a> ·
      Γραμμή για την αυτοκτονία <a href="tel:1018">1018</a> ·
      <a href="/amesi-voitheia/">Όλες οι γραμμές βοήθειας</a>
    </p>

    <nav class="footer-legal" aria-label="Νομικές πληροφορίες">
      <a href="/stoixeia-epaggelmatia/">Στοιχεία επαγγελματία</a>
      <a href="/politiki-aporritou/">Πολιτική απορρήτου</a>
      <a href="/cookies/">Cookies</a>
      <a href="/oroi-xrisis/">Όροι χρήσης</a>
      <a href="/prosvasimotita/">Προσβασιμότητα</a>
    </nav>

    <p class="footer-copy">&copy; <span id="year"></span> {{ settings.legal.fullName }} — {{ settings.legal.title }}. Με επιφύλαξη παντός δικαιώματος.</p>
    <p class="footer-note">Τελευταία ενημέρωση ιστοσελίδας: {{ build.lastUpdated | dateGr }}{% if settings.legal.licenseNumber %} · Άδεια άσκησης επαγγέλματος αρ. {{ settings.legal.licenseNumber }}{% endif %}</p>
  </div>
</footer>

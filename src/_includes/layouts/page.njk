---
layout: layouts/base.njk
---
{#- Layout για σελίδες κειμένου (νομικά, πληροφορίες) #}
<section class="page-hero">
  <div class="container">
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1>{{ heading or title }}</h1>
    {% if lead %}<p class="page-hero-sub">{{ lead }}</p>{% endif %}
  </div>
</section>

<section class="prose-section">
  <div class="container narrow">
    <div class="prose">
      {{ content | safe }}
    </div>
    <p class="prose-updated">Τελευταία ενημέρωση: {{ build.lastUpdated | dateGr }}</p>
  </div>
</section>

# Αντιγράψτε αυτό το αρχείο σε .env και συμπληρώστε πραγματικές, μυστικές τιμές.
# Το .env ΔΕΝ πρέπει ποτέ να μπει σε git (βλ. .gitignore).

NODE_ENV=production
PORT=4000

# Τυχαία, μεγάλη σειρά χαρακτήρων για την υπογραφή των sessions.
# Δημιουργία: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Κλειδί κρυπτογράφησης AES-256 για ευαίσθητα δεδομένα ασθενών (64 hex chars = 32 bytes).
# Δημιουργία: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
